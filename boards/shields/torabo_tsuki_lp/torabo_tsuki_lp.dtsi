#include <zephyr/dt-bindings/gpio/nordic-nrf-gpio.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include "torabo_tsuki_lp_layouts.dtsi"

/ {
    chosen {
        zmk,physical-layout = &physical_layout_xs;
        zmk,kscan = &kscan0;
        zmk,battery = &non_lipo_battery;
    };

    // --- エラー回避用の必須定義 ---
    pointing_listener: pointing_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
    };

    // --- 4x5 (XS) レイアウト定義 ---
    physical_layout_xs: physical_layout_xs {
        compatible = "zmk,physical-layout";
        display-name = "XS Layout (4x5)";
        kscan = <&kscan0>;
        transform = <&size_xs_transform>;
    };

    // --- 4x5 マトリックス変換 ---
    size_xs_transform: size_xs_transform {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)    RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)    RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)    RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4)    RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9)
        >;
    };

    // --- BMP Boost ピン指定 ---
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        col-gpios
            = <&gpio0 23 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // P0.23
            , <&gpio1 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // P1.14
            , <&gpio1  0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // P1.00
            , <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // P1.15
            , <&gpio1  3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // P1.03
            , <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // P0.10
            , <&gpio0  9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // P0.09
            ;
        row-gpios
            = <&gpio0 21 (GPIO_ACTIVE_HIGH)> // P0.21
            , <&gpio0  5 (GPIO_ACTIVE_HIGH)> // P0.05
            , <&gpio0  0 (GPIO_ACTIVE_HIGH)> // P0.00
            , <&gpio0 30 (GPIO_ACTIVE_HIGH)> // P0.30
            , <&gpio0  3 (GPIO_ACTIVE_HIGH)> // P0.03
            ;
        wakeup-source;
    };

    // --- その他必須ノード ---
    leds {
        compatible = "gpio-leds";
        status_led: status_led {
            gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>;
            label = "Status LED";
        };
    };

    status_led_device: status_led_device {
        compatible = "zmk,status-led";
        led = <&status_led>;
    };

    bootloader_trigger: bootloader_trigger {
        compatible = "zmk,cdc-acm-bootloader-trigger";
    };

    non_lipo_battery: non_lipo_battery {
        compatible = "zmk,non-lipo-battery";
        io-channels = <&adc 4>;
    };
};

// BMP Boost SPI設定
&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 17)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 21)>,
                    <NRF_PSEL(SPIM_MISO, 0, 21)>;
        };
    };
    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 17)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 21)>,
                    <NRF_PSEL(SPIM_MISO, 0, 21)>;
            low-power-enable;
        };
    };
};
