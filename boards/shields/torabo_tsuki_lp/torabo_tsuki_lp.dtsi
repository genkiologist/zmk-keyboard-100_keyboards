#include <zephyr/dt-bindings/gpio/nordic-nrf-gpio.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include "torabo_tsuki_lp_layouts.dtsi"

/ {
    chosen {
        // デフォルトでXSサイズ（5x4）を使用
        zmk,physical-layout = &physical_layout_xs;
        zmk,kscan = &kscan0;
        zmk,battery = &non_lipo_battery;
    };

    // XSサイズ：左右5列 × 4行（計40キー）
    // 右手側も左から右へ列番号が増える（ミラー反転なし）
    size_xs_transform: keymap_transform_3 {
        compatible = "zmk,matrix-transform";
        columns = <10>; // 5列 + 5列
        rows = <4>;
        map = <
            // 左手側 (物理COL 0-4)              右手側 (物理COL 0-4 が RC 5-9に対応)
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)    RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)    RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)    RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4)    RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9)
        >;
    };

    // 既存のトランスフォーム（互換性のために保持、ただしkscanのピンはBMP Boost仕様）
    size_s_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <4>;
        map = <
            RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                 RC(1,12) RC(1,11) RC(1,10) RC(1,9) RC(1,8)
            RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)                 RC(2,12) RC(2,11) RC(2,10) RC(2,9) RC(2,8)
            RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,13) RC(3,12) RC(3,11) RC(3,10) RC(3,9) RC(3,8)
            RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,13) RC(4,12) RC(4,11) RC(4,10) RC(4,9) RC(4,8)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";

        // BMP Boostのピン配置表に基づき、物理ピン番号をGPIOに変換
        col-gpios
            = <&gpio0 23 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // COL0: Pin 10 (P0.23)
            , <&gpio1 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // COL1: Pin 16 (P1.14)
            , <&gpio1  0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // COL2: Pin 11 (P1.00)
            , <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // COL3: Pin 15 (P1.15)
            , <&gpio1  3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // COL4: Pin 12 (P1.03)
            , <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // COL5: Pin 14 (P0.10)
            , <&gpio0  9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // COL6: Pin 13 (P0.09)
            ;

        row-gpios
            // ROW0については注意：物理21番ピンがVCCの場合、&gpio0 21(追加IOラベル21)等への読み替えが必要かもしれません
            = <&gpio0 21 (GPIO_ACTIVE_HIGH)> // ROW0: Label 21 (P0.21) または物理21相当
            , <&gpio0  5 (GPIO_ACTIVE_HIGH)> // ROW1: Pin 20 (P0.05)
            , <&gpio0  0 (GPIO_ACTIVE_HIGH)> // ROW2: Pin 19 (P0.00)
            , <&gpio0 30 (GPIO_ACTIVE_HIGH)> // ROW3: Pin 18 (P0.30)
            , <&gpio0  3 (GPIO_ACTIVE_HIGH)> // ROW4: Pin 17 (P0.03)
            ;

        wakeup-source;
    };

    leds {
        compatible = "gpio-leds";
        status_led: status_led {
            gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>; // 表のPin 1 (Label 8) を想定
            label = "Status LED";
        };
    };

    status_led_device: status_led_device {
        compatible = "zmk,status-led";
        led = <&status_led>;
    };

    bootloader_trigger: bootloader_trigger {
        compatible = "zmk,cdc-acm-bootloader-trigger";
    };

    vbatt: vbatt {
        status = "disabled";
    };

    non_lipo_battery: non_lipo_battery {
        compatible = "zmk,non-lipo-battery";
        io-channels = <&adc 4>; // BTラベル AIN4
    };
};

&pinctrl {
    // BMP Boostドキュメントの「デバイスツリーの例」に基づくSPI設定
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 17)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 21)>,
                    <NRF_PSEL(SPIM_MISO, 0, 21)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 17)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 21)>,
                    <NRF_PSEL(SPIM_MISO, 0, 21)>;
            low-power-enable;
        };
    };
};

// 物理レイアウトの定義
&physical_layout_xs {
    compatible = "zmk,physical-layout";
    display-name = "XS Layout (5x4 Split)";
    kscan = <&kscan0>;
    transform = <&size_xs_transform>;
};

&physical_layout_s {
    compatible = "zmk,physical-layout";
    display-name = "S Layout";
    kscan = <&kscan0>;
    transform = <&size_s_transform>;
};
